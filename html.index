<!doctype html>
<html lang="nl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Essentia · Voor cliënten van Balans Rugcentrum</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Instrument+Serif:ital@0;1&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&display=swap">
<style>
/* Leesbaar voor iedereen: korte blokken, grote letters, links uitgelijnd, weinig cursief, vaste volgorde wie-wat-waar-hoe */
:root{
  --ivoor:#F7F2EA; --ivoor-2:#EFE7DA; --marine:#14213D; --bordeaux:#7A1E2C; --goud:#B08D57;
  --tekst:#1B2235; --zacht:#3E4659; --lijn:#DCD2C2; --kaart:#FFFDF9;
  --op-donker:#F7F2EA; --op-donker-zacht:#D3D6DE; --roze-op-donker:#E7B3BB;
  --f-kop:"Manrope",system-ui,-apple-system,"Segoe UI",sans-serif;
  --f-accent:"Instrument Serif",Georgia,serif;
  --f-tekst:"DM Sans",system-ui,-apple-system,"Segoe UI",sans-serif;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --ivoor:#0F1830; --ivoor-2:#14203C; --marine:#0A1124; --bordeaux:#E08C99; --goud:#C9A86F;
    --tekst:#ECE6DB; --zacht:#C4C8D4; --lijn:#2A3858; --kaart:#16213F; color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --ivoor:#0F1830; --ivoor-2:#14203C; --marine:#0A1124; --bordeaux:#E08C99; --goud:#C9A86F;
  --tekst:#ECE6DB; --zacht:#C4C8D4; --lijn:#2A3858; --kaart:#16213F; color-scheme:dark;
}
*{box-sizing:border-box}
body{margin:0;background:var(--ivoor);color:var(--tekst);font-family:var(--f-tekst);font-size:18px;line-height:1.7;letter-spacing:.005em;-webkit-font-smoothing:antialiased}
.band{padding-left:max(18px,env(safe-area-inset-left,0px));padding-right:max(18px,env(safe-area-inset-right,0px))}
.wrap{max-width:960px;margin:0 auto}
h1,h2,h3{font-family:var(--f-kop);letter-spacing:-.015em;text-wrap:balance;margin:0}
p{margin:0;max-width:60ch}
b,strong{font-weight:700}
em.acc{font-family:var(--f-accent);font-style:italic;font-weight:400;letter-spacing:0}
.oog{font-family:var(--f-kop);font-size:13px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--bordeaux)}
section .wrap{padding-block:56px}
.kop2{font-size:clamp(26px,4vw,36px);line-height:1.2;font-weight:800;margin-top:8px}
.intro{color:var(--zacht);margin-top:12px}

/* Hero */
.hero{background:var(--marine);color:var(--op-donker)}
.hero .wrap{padding-block:40px 56px;display:grid;gap:22px}
.merk{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;padding-bottom:18px;border-bottom:1px solid color-mix(in srgb,var(--goud) 45%,transparent)}
.logo{font-family:var(--f-kop);font-weight:800;font-size:18px}
.logo span{font-family:var(--f-accent);font-style:italic;font-weight:400;color:var(--goud);font-size:20px;margin-left:4px}
.hero .oog{color:var(--goud)}
.hero h1{font-size:clamp(32px,6vw,54px);line-height:1.1;font-weight:800;max-width:18ch}
.hero h1 em.acc{color:var(--roze-op-donker)}
.hero .lead{font-size:20px;color:var(--op-donker-zacht)}
.hero .lead + .lead{margin-top:-8px}
.feiten{list-style:none;padding:0;margin:6px 0 0;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}
.feiten li{border:1px solid color-mix(in srgb,var(--op-donker) 22%,transparent);border-radius:12px;padding:14px 16px}
.feiten .k{display:block;font-family:var(--f-kop);font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--goud)}
.feiten .v{display:block;font-weight:600;color:var(--op-donker);line-height:1.45;margin-top:2px}
.knoppen{display:flex;flex-wrap:wrap;gap:12px;align-items:center}
.knop{display:inline-flex;align-items:center;gap:10px;font-family:var(--f-kop);font-weight:700;font-size:16px;padding:15px 24px;border-radius:999px;text-decoration:none;transition:transform .15s ease}
.knop:hover{transform:translateY(-1px)}
.knop:focus-visible,.kopie:focus-visible,.ebook:focus-visible{outline:2px solid var(--goud);outline-offset:3px}
.knop.vol{background:#8C2333;color:#fff}
.knop.rand{border:1px solid color-mix(in srgb,var(--op-donker) 45%,transparent);color:var(--op-donker)}

/* Herken je dit */
.thema{list-style:none;padding:0;margin:24px 0 0;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}
.thema li{background:var(--kaart);border:1px solid var(--lijn);border-radius:14px;padding:18px}
.thema b{display:block;font-family:var(--f-kop);font-size:17px}
.thema span{display:block;color:var(--zacht);font-size:16px;margin-top:4px;line-height:1.5}
.zin{margin-top:22px;font-weight:600;font-size:19px}

/* Aanbod */
.tint{background:var(--ivoor-2)}
.twee{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:18px;margin-top:26px}
.kaart{background:var(--kaart);border:1px solid var(--lijn);border-radius:16px;padding:26px;display:flex;flex-direction:column;gap:12px;min-width:0}
.kaart h3{font-size:22px;font-weight:800}
.vink{list-style:none;padding:0;margin:0;display:grid;gap:8px}
.vink li{padding-left:28px;position:relative;line-height:1.5}
.vink li::before{content:"✓";position:absolute;left:0;top:0;color:var(--goud);font-weight:800}
.samen{margin-top:24px;font-weight:600;font-size:19px}

/* Hoe werkt guasha */
.stappen{list-style:none;padding:0;margin:26px 0 0;display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px;counter-reset:s}
.stappen li{counter-increment:s;border-top:2px solid var(--goud);padding-top:14px;min-width:0}
.stappen li::before{content:counter(s);display:inline-grid;place-items:center;width:30px;height:30px;border-radius:50%;background:var(--marine);color:var(--op-donker);font-family:var(--f-kop);font-weight:800;font-size:15px;margin-bottom:10px}
.stappen b{display:block;font-family:var(--f-kop);font-size:18px}
.stappen p{color:var(--zacht);margin-top:6px;font-size:17px;line-height:1.6}
.labels{margin-top:34px}
.balans{margin-top:24px;padding:22px 24px;border-left:3px solid var(--goud);background:var(--kaart);border-radius:0 14px 14px 0;max-width:820px}
.balans p:not(.groot-woord){color:var(--zacht)}
.groot-woord{font-family:var(--f-kop);font-weight:800;font-size:clamp(24px,3.4vw,32px);line-height:1.2;margin-top:6px}
.groot-woord em.acc{color:var(--bordeaux)}
.voordelen{margin-top:14px;max-width:820px;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:10px 28px}
.chips{display:flex;flex-wrap:wrap;gap:10px;margin-top:12px}
.chips span{border:1px solid var(--lijn);background:var(--kaart);border-radius:999px;padding:8px 15px;font-family:var(--f-kop);font-weight:600;font-size:15px}
.noot{font-size:15px;color:var(--zacht);margin-top:14px}
.ebook{display:grid;grid-template-columns:96px 1fr;gap:20px;align-items:center;margin-top:34px;padding:20px;background:var(--kaart);border:1px solid var(--lijn);border-radius:16px;text-decoration:none;color:inherit}
.ebook img{width:100%;height:auto;border-radius:6px;box-shadow:0 6px 18px rgba(20,33,61,.18);display:block}
.ebook h3{font-size:19px;font-weight:800}
.ebook p:not(.oog){color:var(--zacht);font-size:16px;margin-top:4px}
.ebook .ga{display:inline-block;margin-top:8px;font-family:var(--f-kop);font-weight:700;font-size:15px;color:var(--bordeaux)}

/* Zo maak je een afspraak */
.route{list-style:none;padding:0;margin:26px 0 0;display:grid;gap:0}
.route li{display:grid;grid-template-columns:44px 1fr auto;gap:16px;align-items:start;padding:18px 0;border-bottom:1px solid var(--lijn)}
.route li:first-child{border-top:1px solid var(--lijn)}
.route .n{width:36px;height:36px;border-radius:50%;background:var(--bordeaux);color:#fff;display:grid;place-items:center;font-family:var(--f-kop);font-weight:800}
.route b{display:block;font-family:var(--f-kop);font-size:18px}
.route span.t{display:block;color:var(--zacht);font-size:16px;line-height:1.5;margin-top:2px}
.route .p{font-family:var(--f-kop);font-weight:800;font-size:18px;white-space:nowrap;font-variant-numeric:tabular-nums}
@media (max-width:520px){.route li{grid-template-columns:40px 1fr}.route .p{grid-column:2}}

/* Over */
.over{display:grid;grid-template-columns:minmax(170px,240px) 1fr;gap:32px;align-items:center}
.foto{width:100%;height:auto;aspect-ratio:4/5;object-fit:cover;border-radius:14px;display:block}
.over h2{font-size:28px;font-weight:800;margin-top:6px}
.over .titel{font-family:var(--f-kop);font-weight:700;font-size:15px;color:var(--bordeaux);margin-top:4px}
.over p + p{margin-top:10px}
.over a{color:var(--bordeaux);text-underline-offset:3px}
@media (max-width:560px){.over{grid-template-columns:1fr}.foto{max-width:260px}}

/* Slot */
.slot{background:var(--marine);color:var(--op-donker)}
.slot .wrap{padding-block:56px;display:grid;gap:20px}
.slot h2{font-size:clamp(28px,4.4vw,40px);line-height:1.15;font-weight:800;max-width:22ch}
.slot h2 em.acc{color:var(--roze-op-donker)}
.slot p{color:var(--op-donker-zacht)}
.contact{display:flex;flex-wrap:wrap;gap:12px 24px;align-items:center;font-family:var(--f-kop);font-weight:600}
.contact .nr{font-size:26px;font-weight:800;color:var(--op-donker);user-select:all;font-variant-numeric:tabular-nums}
.kopie{background:none;border:1px solid color-mix(in srgb,var(--op-donker) 40%,transparent);color:var(--op-donker);border-radius:999px;padding:8px 15px;font:600 14px var(--f-kop);cursor:pointer}
.voet{border-top:1px solid color-mix(in srgb,var(--goud) 40%,transparent);padding-top:16px;display:flex;flex-wrap:wrap;justify-content:space-between;gap:10px;font-size:15px;color:var(--op-donker-zacht)}
.voet a{color:var(--goud)}
.klein{font-size:14px;opacity:.9}
/* Cirkel */
.viz{display:grid;grid-template-columns:minmax(260px,420px) 1fr;gap:36px;align-items:center;margin-top:30px}
@media (max-width:720px){.viz{grid-template-columns:1fr}.cirkel{max-width:400px;margin:0 auto}}
.cirkel{width:100%;height:auto;display:block}
.cirkel .baan{fill:none;stroke:var(--bordeaux);stroke-width:2.5;stroke-dasharray:6 7;opacity:.55}
.cirkel .pijl{fill:var(--bordeaux)}
.cirkel .node{fill:var(--kaart);stroke:var(--lijn);stroke-width:1.5}
.cirkel .nr-bol{fill:var(--bordeaux)}
.cirkel .nr-t{fill:#fff;font:800 13px var(--f-kop)}
.cirkel .node-t{fill:var(--tekst);font:800 15px var(--f-kop)}
.cirkel .node-s{fill:var(--zacht);font:500 12.5px var(--f-tekst)}
.cirkel .hart{fill:var(--marine);stroke:var(--goud);stroke-width:3}
.cirkel .hart-t{fill:#F7F2EA;font:800 19px var(--f-kop)}
.cirkel .hart-s{fill:#E7B3BB;font:600 13.5px var(--f-kop)}
.viz-kop{font-family:var(--f-kop);font-weight:800;font-size:19px}
.viz-tekst{color:var(--zacht);margin-top:6px}
</style>
</head>
<body>

<header class="hero band">
  <div class="wrap">
    <div class="merk">
      <div class="logo">Essentia<span>Holistic Care</span></div>
      <div class="oog">Best &amp; Eindhoven</div>
    </div>
    <p class="oog">Voor cliënten van Balans Rugcentrum</p>
    <h1>Je lijf is flink hersteld. <em class="acc">Nu zorgen we dat het zo blijft.</em></h1>
    <p class="lead">Samen met je behandelaar bij Balans Rugcentrum heb je al zoveel bereikt. Daar mag je echt trots op zijn.</p>
    <p class="lead">Toch kan er nog wat spanning overblijven. Vaak omdat er in je leven iets speelt dat veel van je vraagt en stress geeft. Dan ben je hier op het goede adres. Essentia helpt je bij stressregulatie, fysiek én mentaal: met een ontspannende guasha behandeling en/of een verhelderend coachinggesprek.</p>
    <ul class="feiten">
      <li><span class="k">Wat</span><span class="v">Gesprek + guasha behandeling</span></li>
      <li><span class="k">Waar</span><span class="v">Best en Eindhoven</span></li>
      <li><span class="k">Prijs</span><span class="v">Eerste afspraak, 90 min incl. intake: €82,50</span></li>
      <li><span class="k">Afspraak</span><span class="v">App of bel <span style="white-space:nowrap">06 41 47 95 07</span></span></li>
    </ul>
    <div class="knoppen">
      <a class="knop vol" href="https://wa.me/31641479507?text=Hoi%20Carine%2C%20ik%20ben%20doorverwezen%20door%20Balans%20Rugcentrum%20en%20wil%20graag%20een%20afspraak%20maken." target="_blank" rel="noopener">App voor een afspraak</a>
      <a class="knop rand" href="#afspraak">Zo werkt het</a>
    </div>
  </div>
</header>

<section class="band">
  <div class="wrap">
    <p class="oog">Herken je dit?</p>
    <h2 class="kop2">De pijn is grotendeels weg. <em class="acc">Maar je hoofd zit nog vol.</em></h2>
    <p class="intro">Nu de fysieke pijn grotendeels is hersteld, blijft er misschien nog een mentale uitdaging over. Soms merk je aan je lichaam hoeveel het leven van je vraagt. Bijvoorbeeld door:</p>
    <ul class="thema">
      <li><b>Een scheiding</b><span>Je relatie verandert of stopt.</span></li>
      <li><b>Werk dat verandert</b><span>Een nieuwe baan, of je werk stopt.</span></li>
      <li><b>Verlies</b><span>Je mist iemand die je dierbaar is.</span></li>
      <li><b>Alle ballen hoog houden</b><span>Werk, gezin en zorg. Jij komt op de laatste plek.</span></li>
    </ul>
    <p class="zin">Die spanning zet zich vast in je lijf. Dat is geen teken dat je herstel mislukt. Het is een seintje dat er nog één laag aandacht wil.</p>
  </div>
</section>

<section class="tint band">
  <div class="wrap">
    <p class="oog">Wat ik doe</p>
    <h2 class="kop2">Lijf en hoofd. <em class="acc">Samen.</em></h2>
    <div class="twee">
      <article class="kaart">
        <p class="oog">Ontspannen</p>
        <h3>Guasha behandeling</h3>
        <ul class="vink">
          <li>Je ligt op de behandeltafel of zit in een massagestoel</li>
          <li>Ik werk met een gladde schraper en warme olie</li>
          <li>Ik behandel wat jouw klacht vraagt: rug, nek, schouders of benen. Niet altijd alles tegelijk.</li>
          <li>Je spieren laten los en je komt tot rust</li>
        </ul>
      </article>
      <article class="kaart">
        <p class="oog">Verhelderen</p>
        <h3>Intakegesprek</h3>
        <ul class="vink">
          <li>We kijken wat er nog spanning geeft</li>
          <li>Je ziet welke patronen je onder druk zetten</li>
          <li>Je krijgt tools voor als het druk wordt</li>
          <li>Zo blijft je herstel staan</li>
        </ul>
      </article>
    </div>
    <p class="samen">Je hoeft niet eerst vast te lopen om aandacht aan jezelf te geven.</p>
  </div>
</section>

<section class="band" id="guasha">
  <div class="wrap">
    <p class="oog">Hoe werkt guasha?</p>
    <h2 class="kop2">Een eeuwenoude behandeling <em class="acc">uit de Chinese geneeskunde.</em></h2>
    <p class="intro">Guasha is één behandeling. Je herkent er de werking in van <b>massage</b>, <b>reflexzonetherapie</b>, <b>acupunctuur</b> (maar dan zonder naalden), <b>cupping</b>, <b>lymfedrainage</b> en <b>ontspanningstherapie</b>. Al die effecten komen samen in guasha.</p>

    <div class="viz">
      <svg class="cirkel" viewBox="-14 0 482 460" role="img" aria-labelledby="cirkel-titel cirkel-uitleg">
<title id="cirkel-titel">De cirkel van afvalstoffen</title>
<desc id="cirkel-uitleg">Stress zorgt dat afvalstoffen worden opgeslagen in je weefsel. Het weefsel slibt dicht, je wordt stijf, moe en krijgt pijn. Dat geeft weer meer stress. Guasha in het midden doorbreekt die cirkel.</desc>
<circle class="baan" cx="230" cy="230" r="160"/>
<polygon class="pijl" points="336.8,349.5 353.0,343.1 343.1,333.2"/><polygon class="pijl" points="110.5,336.8 116.9,353.0 126.8,343.1"/><polygon class="pijl" points="123.2,110.5 107.0,116.9 116.9,126.8"/><polygon class="pijl" points="349.5,123.2 343.1,107.0 333.2,116.9"/>
<g><rect class="node" x="152" y="40" width="156" height="60" rx="14"/>
<circle class="nr-bol" cx="152" cy="40" r="13"/><text class="nr-t" x="152" y="44.5" text-anchor="middle">1</text>
<text class="node-t" x="230" y="66" text-anchor="middle">Stress</text>
<text class="node-s" x="230" y="86" text-anchor="middle">Het leven vraagt veel</text></g><g><rect class="node" x="297" y="200" width="156" height="60" rx="14"/>
<circle class="nr-bol" cx="297" cy="200" r="13"/><text class="nr-t" x="297" y="204.5" text-anchor="middle">2</text>
<text class="node-t" x="375" y="226" text-anchor="middle">Afvalstoffen</text>
<text class="node-s" x="375" y="246" text-anchor="middle">Opgeslagen in weefsel</text></g><g><rect class="node" x="152" y="360" width="156" height="60" rx="14"/>
<circle class="nr-bol" cx="152" cy="360" r="13"/><text class="nr-t" x="152" y="364.5" text-anchor="middle">3</text>
<text class="node-t" x="230" y="386" text-anchor="middle">Weefsel slibt dicht</text>
<text class="node-s" x="230" y="406" text-anchor="middle">Minder zuurstof</text></g><g><rect class="node" x="7" y="200" width="156" height="60" rx="14"/>
<circle class="nr-bol" cx="7" cy="200" r="13"/><text class="nr-t" x="7" y="204.5" text-anchor="middle">4</text>
<text class="node-t" x="85" y="226" text-anchor="middle">Stijf, moe, pijn</text>
<text class="node-s" x="85" y="246" text-anchor="middle">Meer stress</text></g>
<circle class="hart" cx="230" cy="230" r="60"/>
<text class="hart-t" x="230" y="226" text-anchor="middle">Guasha</text>
<text class="hart-s" x="230" y="248" text-anchor="middle">doorbreekt</text>
<text class="hart-s" x="230" y="265" text-anchor="middle">de cirkel</text>
</svg>
      <div class="viz-uit">
        <p class="viz-kop">Zo kom je vast te zitten</p>
        <p class="viz-tekst">Bij veel stress zet je lijf afvalstoffen weg in je bindweefsel. Het weefsel slibt dicht. Je wordt stijf en moe. En dat geeft weer stress. Een cirkel.</p>
        <p class="viz-kop" style="margin-top:22px">Zo maakt guasha de weg vrij</p>
        <ul class="vink" style="margin-top:8px">
          <li>Het weefsel gaat weer open</li>
          <li>Je doorbloeding komt op gang</li>
          <li>Afvalstoffen worden afgevoerd</li>
          <li>Je energie stroomt weer</li>
        </ul>
      </div>
    </div>
    <p class="noot">Soms zie je na de behandeling rode vlekjes op je huid. Dat heet sha. Het is een goed teken en trekt binnen een paar dagen weg.</p>

    <div class="labels">
      <p class="oog">De voordelen van guasha</p>
      <ul class="vink voordelen">
        <li>Bevordert de stroom van Qi en bloed</li>
        <li>Vermindert spanning en stress</li>
        <li>Vermindert pijnklachten</li>
        <li>Meer ruimte in nek, schouders, rug en benen</li>
        <li>Bevordert de werking van je zenuwstelsel</li>
        <li>Geeft mentale rust en beter slapen</li>
        <li>Brengt emoties in evenwicht</li>
        <li>Ontgift en ontzuurt</li>
        <li>Stimuleert en optimaliseert orgaanfuncties</li>
        <li>Versterkt je weerstand</li>
      </ul>
      <div class="balans">
        <p>Guasha werkt positief op je zenuwstelsel, lymfestelsel, bloedvaten, huid, psyche en organen.</p>
        <p class="groot-woord">Guasha brengt <em class="acc">balans.</em></p>
      </div>
    </div>

    <div class="labels">
      <p class="oog">Guasha kan ondersteunen bij</p>
      <div class="chips">
        <span>Stress en burn-out</span>
        <span>Hoofdpijn en migraine</span>
        <span>RSI</span>
        <span>Reumatische klachten</span>
        <span>Hoge bloeddruk</span>
        <span>Bronchitis en astma</span>
